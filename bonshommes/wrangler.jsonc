{
  "name": "bonshommes",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "limits": { "cpu_ms": 300000 },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "containers": [
    { "class_name": "Atelier", "image": "./container/Dockerfile", "max_instances": 1, "instance_type": "standard-2" }
  ],
  "durable_objects": { "bindings": [
    { "name": "COFFRE", "class_name": "Coffre" },
    { "name": "ATELIER", "class_name": "Atelier" }
  ] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coffre", "Atelier"] }]
}
