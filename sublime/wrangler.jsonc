{
  "name": "sublime",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "COFFRE", "class_name": "Coffre" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coffre"] }]
}
