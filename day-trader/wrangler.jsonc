{
  "name": "day-trader",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "limits": { "cpu_ms": 300000 },
  "durable_objects": { "bindings": [{ "name": "COFFRE", "class_name": "Coffre" }, { "name": "VEILLEUR", "class_name": "Veilleur" }, { "name": "FLUX", "class_name": "Flux" }, { "name": "JETONS", "class_name": "Jetons" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Coffre"] }, { "tag": "v2", "new_sqlite_classes": ["Veilleur"] }, { "tag": "v3", "new_sqlite_classes": ["Flux"] }, { "tag": "v4", "new_sqlite_classes": ["Jetons"] }],
  "d1_databases": [{ "binding": "DB", "database_name": "day-trader", "database_id": "5c5a8e89-b869-4b7b-80b8-0ba6e5e76846" }],
  "triggers": { "crons": ["* * * * *", "17 13 * * 1-5", "25 21 * * 1-5"] }
}
