{
  "name": "wallet-autopsy",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "wallet-autopsy", "database_id": "A_REMPLACER_PAR_LE_WORKFLOW", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["* * * * *"] }
}
